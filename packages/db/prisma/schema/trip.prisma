enum TripTransport {
  MOTORCYCLE
  CAR
}

model Trip {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate    DateTime       @db.Date
  durationDays Int
  transport    TripTransport
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  manuallyCompletedAt DateTime?
  days         ItineraryDay[]
  favorites    Favorite[]
  companionPublication TripCompanionPublication?

  @@index([userId, createdAt])
  @@map("trip")
}

// Unique publication remains the stable group identity across lifecycle changes.
model TripCompanionPublication {
  id                 String       @id @default(cuid())
  tripId             String       @unique
  trip               Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title              String       @db.VarChar(200)
  introduction       String       @db.VarChar(4000)
  additionalCapacity Int
  imageMediaId       String?
  imageMedia         ContentMedia? @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now())
  everHadMembers     Boolean      @default(false)
  visibility         CompanionVisibility @default(PUBLIC)
  recruitmentOpen    Boolean @default(true)
  managementRevision Int @default(0)
  messageSequence    BigInt @default(0)
  itineraryRevision  BigInt @default(0)
  canceledAt         DateTime?
  messages           TripCompanionMessage[]
  readMarkers        TripCompanionReadMarker[]
  memberships        TripCompanionMembership[]

  @@index([imageMediaId])
  @@map("trip_companion_publication")
}

enum CompanionMembershipState {
  ACTIVE
  LEFT
  BANNED
}

enum CompanionVisibility {
  PUBLIC
  WITHDRAWN
}

model TripCompanionMembership {
  publicationId String
  userId        String
  publication   TripCompanionPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  user          User @relation(fields: [userId], references: [id], onDelete: Restrict)
  state         CompanionMembershipState @default(ACTIVE)
  joinedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@id([publicationId, userId])
  @@index([userId, state, publicationId])
  @@map("trip_companion_membership")
}

enum CompanionMessageKind {
  USER
  SYSTEM
}

model TripCompanionMessage {
  id            String @id @default(cuid())
  publicationId String
  publication   TripCompanionPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  sequence      BigInt
  kind          CompanionMessageKind @default(USER)
  authorId      String?
  author        User? @relation(fields: [authorId], references: [id], onDelete: Restrict)
  notice        Json?
  text          String @db.VarChar(4000)
  createdAt     DateTime @default(now())

  @@unique([publicationId, sequence])
  @@map("trip_companion_message")
}

model TripCompanionReadMarker {
  publicationId String
  userId        String
  publication   TripCompanionPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user          User @relation(fields: [userId], references: [id], onDelete: Restrict)
  lastReadSequence BigInt @default(0)
  updatedAt     DateTime @updatedAt

  @@id([publicationId, userId])
  @@index([userId, publicationId])
  @@map("trip_companion_read_marker")
}

model ItineraryDay {
  id        String           @id @default(cuid())
  tripId    String
  trip      Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayIndex  Int
  localDate DateTime         @db.Date
  visits    ItineraryVisit[]

  @@unique([tripId, dayIndex])
  @@map("itinerary_day")
}

model ItineraryVisit {
  id                     String       @id @default(cuid())
  dayId                  String
  day                    ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  destinationId          String
  destination            Destination  @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  startMinute            Int
  plannedDurationMinutes Int
  order                  Int

  @@unique([dayId, order])
  @@index([destinationId])
  @@map("itinerary_visit")
}
