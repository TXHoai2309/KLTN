enum TripTransport {
  MOTORCYCLE
  CAR
}

model Trip {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate    DateTime       @db.Date
  durationDays Int
  transport    TripTransport
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  manuallyCompletedAt DateTime?
  // Owner-private origin, clocks and authoritative policy/route projection.
  journeySnapshot Json?
  // Ticket 09 (Q21'a): checks the owner saved as UNCHECKED (data missing), confirmed explicitly. NULL = nothing unchecked
  // (every legacy and every all-PASS Trip). Shape: {revision:"unchecked-save-v1", items:[{check, reasonCode, placeId}]}.
  uncheckedChecks Json?
  uncheckedConfirmedAt DateTime? @db.Timestamptz(3)
  days         ItineraryDay[]
  favorites    Favorite[]
  companionPublication TripCompanionPublication?
  editChatMessages TripEditChatMessage[]

  @@index([userId, createdAt])
  @@map("trip")
}

model TripEditChatMessage {
  id             String   @id @default(cuid())
  tripId         String
  trip           Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  role           String   @db.VarChar(16)
  kind           String?  @db.VarChar(24)
  text           String   @db.Text
  steps          Json?
  correctionNote String?  @db.Text
  statusNotice   String?  @db.Text
  knowledgeParts Json?
  citations      Json?
  createdAt      DateTime @default(now())

  @@index([tripId, createdAt])
  @@map("trip_edit_chat_message")
}

// Unique publication remains the stable group identity across lifecycle changes.
model TripCompanionPublication {
  id                 String       @id @default(cuid())
  tripId             String       @unique
  trip               Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title              String       @db.VarChar(200)
  introduction       String       @db.VarChar(4000)
  additionalCapacity Int
  imageMediaId       String?
  imageMedia         ContentMedia? @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now())
  everHadMembers     Boolean      @default(false)
  visibility         CompanionVisibility @default(PUBLIC)
  recruitmentOpen    Boolean @default(true)
  managementRevision Int @default(0)
  messageSequence    BigInt @default(0)
  itineraryRevision  BigInt @default(0)
  canceledAt         DateTime?
  messages           TripCompanionMessage[]
  readMarkers        TripCompanionReadMarker[]
  memberships        TripCompanionMembership[]

  @@index([imageMediaId])
  @@map("trip_companion_publication")
}

enum CompanionMembershipState {
  ACTIVE
  LEFT
  BANNED
}

enum CompanionVisibility {
  PUBLIC
  WITHDRAWN
}

model TripCompanionMembership {
  publicationId String
  userId        String
  publication   TripCompanionPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  user          User @relation(fields: [userId], references: [id], onDelete: Restrict)
  state         CompanionMembershipState @default(ACTIVE)
  joinedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@id([publicationId, userId])
  @@index([userId, state, publicationId])
  @@map("trip_companion_membership")
}

enum CompanionMessageKind {
  USER
  SYSTEM
}

model TripCompanionMessage {
  id            String @id @default(cuid())
  publicationId String
  publication   TripCompanionPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  sequence      BigInt
  kind          CompanionMessageKind @default(USER)
  authorId      String?
  author        User? @relation(fields: [authorId], references: [id], onDelete: Restrict)
  notice        Json?
  text          String @db.VarChar(4000)
  createdAt     DateTime @default(now())

  @@unique([publicationId, sequence])
  @@map("trip_companion_message")
}

model TripCompanionReadMarker {
  publicationId String
  userId        String
  publication   TripCompanionPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user          User @relation(fields: [userId], references: [id], onDelete: Restrict)
  lastReadSequence BigInt @default(0)
  updatedAt     DateTime @updatedAt

  @@id([publicationId, userId])
  @@index([userId, publicationId])
  @@map("trip_companion_read_marker")
}

model ItineraryDay {
  id        String           @id @default(cuid())
  tripId    String
  trip      Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayIndex  Int
  localDate DateTime         @db.Date
  visits    ItineraryVisit[]

  @@unique([tripId, dayIndex])
  @@map("itinerary_day")
}

model ItineraryVisit {
  id                     String       @id @default(cuid())
  dayId                  String
  day                    ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  // Exactly one of destinationId / externalPlaceId is set (DB CHECK itinerary_visit_exactly_one_place).
  destinationId          String?
  destination            Destination? @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  externalPlaceId        String?
  externalPlace          ExternalPlace? @relation(fields: [externalPlaceId], references: [id], onDelete: Restrict)
  startMinute            Int
  plannedDurationMinutes Int
  order                  Int

  @@unique([dayId, order])
  @@index([destinationId])
  @@index([externalPlaceId])
  @@map("itinerary_visit")
}

enum ExternalPlaceProvider {
  GOOGLE_PLACES
}

// Place outside the KLTN destination table (Q18b/Q22). Shared reference row keyed by the
// provider's place id (a public identifier, exempt from Google caching limits); it holds no
// per-user data, and users reach it only through their own Trip's ItineraryVisit.
// name/latitude/longitude are nullable provider content: Google allows coordinates cached at most
// 30 consecutive days and disallows saving business names, so they must be nulled/refetched once
// fetchedAt is older than that (see docs/research/google-places-storage-terms.md).
model ExternalPlace {
  id              String                @id @default(cuid())
  provider        ExternalPlaceProvider
  providerPlaceId String
  name            String?
  latitude        Float?
  longitude       Float?
  source          String
  fetchedAt       DateTime              @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  visits          ItineraryVisit[]

  @@unique([provider, providerPlaceId])
  @@index([fetchedAt])
  @@map("external_place")
}
