enum TripTransport {
  MOTORCYCLE
  CAR
}

model Trip {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate    DateTime       @db.Date
  durationDays Int
  transport    TripTransport
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  manuallyCompletedAt DateTime?
  days         ItineraryDay[]
  favorites    Favorite[]
  companionPublication TripCompanionPublication?

  @@index([userId, createdAt])
  @@map("trip")
}

// TC-01 only: the unique publication is the stable identity for later group work.
model TripCompanionPublication {
  id                 String       @id @default(cuid())
  tripId             String       @unique
  trip               Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title              String       @db.VarChar(200)
  introduction       String       @db.VarChar(4000)
  additionalCapacity Int
  imageMediaId       String?
  imageMedia         ContentMedia? @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now())

  @@index([imageMediaId])
  @@map("trip_companion_publication")
}

model ItineraryDay {
  id        String           @id @default(cuid())
  tripId    String
  trip      Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayIndex  Int
  localDate DateTime         @db.Date
  visits    ItineraryVisit[]

  @@unique([tripId, dayIndex])
  @@map("itinerary_day")
}

model ItineraryVisit {
  id                     String       @id @default(cuid())
  dayId                  String
  day                    ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  destinationId          String
  destination            Destination  @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  startMinute            Int
  plannedDurationMinutes Int
  order                  Int

  @@unique([dayId, order])
  @@index([destinationId])
  @@map("itinerary_visit")
}
