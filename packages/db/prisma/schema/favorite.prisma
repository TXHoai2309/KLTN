enum FavoriteTargetType {
  DESTINATION
  CULTURE_CONTENT
  TRIP
}

model Favorite {
  id               String             @id @default(cuid())
  userId           String
  targetType       FavoriteTargetType
  destinationId    String?
  cultureContentId String?
  tripId           String?
  createdAt        DateTime           @default(now())
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination      Destination?       @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  cultureContent   CultureContent?    @relation(fields: [cultureContentId], references: [id], onDelete: Restrict)
  trip             Trip?              @relation(fields: [tripId], references: [id], onDelete: Restrict)

  @@unique([userId, destinationId])
  @@unique([userId, cultureContentId])
  @@unique([userId, tripId])
  @@index([userId, createdAt])
  @@map("favorite")
}
