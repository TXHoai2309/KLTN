# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Vercel deployment environment; not a credential.
# @required=false @sensitive=false @dynamic
VERCEL_ENV=

# @internal @required=false
VERCEL_URL=

# @internal @required=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=$VERCEL_ORIGIN

# @type=string(minLength=1)
DATABASE_URL=
# @required=false
OPENAI_API_KEY=

# Local and Preview Q&A require explicit opt-in, owner acceptance of abuse
# protection, and an exact non-production database host/name allowlist.
# @required=false @type=boolean
QA_RUNTIME_ENABLED=false

# Vercel Preview only.
# @required=false @type=boolean
QA_PREVIEW_RUNTIME_ENABLED=false

# Vercel Production runtime gate; default false.
# @required=false @type=boolean
QA_PRODUCTION_RUNTIME_ENABLED=false

# Owner-controlled release gate; keep false until Guest abuse controls are accepted.
# @required=false @type=boolean
QA_ABUSE_PROTECTION_ACCEPTED=false

# Exact Neon development branch target required before local/Preview can run QA.
# Do not point this at a Production branch.
# @required=false
QA_RUNTIME_ALLOWED_DATABASE_HOST=
# @required=false
QA_RUNTIME_ALLOWED_DATABASE_NAME=

# Comma-separated RagDocument IDs whose source title and locator metadata have
# explicit public-display approval. Empty means no citation metadata is exposed.
# @required=false
QA_PUBLIC_SOURCE_IDS=

# Server-only HMAC for pseudonymous durable network budgets. Keep stable across
# instances; rotating it resets per-network counters and requires owner review.
# @required=false @type=string(minLength=32)
QA_NETWORK_HMAC_SECRET=

# Explicit shared identity for local development API/browser harness only.
# Runtime ignores this outside development and never reads client IP headers here.
# @required=false
QA_LOCAL_NETWORK_ID=

# Cleanup is independently gated and never scheduled by this setting alone.
# @required=false @type=boolean
QA_CLEANUP_ENABLED=false

# Exact database target pin required before the cleanup route can run.
# Keep false/empty on every environment that is not explicitly approved.
# @required=false
QA_CLEANUP_ALLOWED_DATABASE_HOST=
# @required=false
QA_CLEANUP_ALLOWED_DATABASE_NAME=

# Server-only scheduler credential; Vercel sends it as a Bearer header.
# @required=false @type=string(minLength=32)
CRON_SECRET=

# Platform-set Vercel ingress indicator; not a credential.
# @required=false @sensitive=false @dynamic
VERCEL=

# @required=false
BLOB_READ_WRITE_TOKEN=

# Destination images: optional, server-only. Empty config disables only uploads.
# @required=false @sensitive=false
CLOUDINARY_CLOUD_NAME=
# @required=false @sensitive=true
CLOUDINARY_API_KEY=
# @required=false @sensitive=true
CLOUDINARY_API_SECRET=
# @required=false @sensitive=false
CLOUDINARY_DESTINATION_FOLDER=KLTN/destinations

# @internal @required=false
OPENAI_PREFERENCE_MODEL=

# Optional explicit model for Admin-triggered editorial layout proposals.
# @required=false @sensitive=true
OPENAI_EDITORIAL_MODEL=

# Optional timeout in ms for Editorial layout proposals (V4 defaults to 240000ms, max 240000ms).
# The Admin AI Design UI explicitly requests 240000ms; this value applies to callers without an override.
# @required=false @sensitive=false
OPENAI_EDITORIAL_TIMEOUT_MS=

# Server-only routing credential, injected at runtime.
# @required=false @sensitive=true
STADIA_MAPS_API_KEY=

# @internal @required=false
INITIAL_ADMIN_NAME=

# @internal @required=false
INITIAL_ADMIN_EMAIL=

# @internal @required=false
INITIAL_ADMIN_PASSWORD=
