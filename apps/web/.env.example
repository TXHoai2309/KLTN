# Môi trường local: dùng development khi chạy ứng dụng trên máy cá nhân.
NODE_ENV=development

# Better Auth dùng base URL của ứng dụng local hiện tại.
BETTER_AUTH_URL=http://localhost:3010

# Secret riêng cho Better Auth ở môi trường local.
# Tạo secret bằng lệnh:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Không dùng chung secret local với Preview hoặc Production.
BETTER_AUTH_SECRET=

# Connection string PostgreSQL của Neon, luôn chọn branch development khi chạy local.
# Ví dụ định dạng: postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require
# Không dùng connection string production.
DATABASE_URL=

# OpenAI API key phía server cho AI/RAG, embeddings, planner và tác vụ OpenAI.
# Có thể để trống khi chưa triển khai AI; không đổi tên thành NEXT_PUBLIC_*.
OPENAI_API_KEY=

# Tên model trích xuất nhu cầu chuyến đi, chỉ dùng phía server.
# Để trống khi US25 chưa có owner-approved provider/model; không có giá trị mặc định.
OPENAI_PREFERENCE_MODEL=
# Private RAG Blob store; server-side secret only.
BLOB_READ_WRITE_TOKEN=

# Cloudinary product environment selected by the owner; server-only credentials.
# Leave credentials blank until configured. No other project folder is accepted.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_DESTINATION_FOLDER=KLTN/destinations

# Google Routes API key phía server cho routing, distance, travel time,
# DRIVE, TWO_WHEELER và Constraint Validator. Không dùng NEXT_PUBLIC_.
GOOGLE_ROUTES_API_KEY=
# Stadia Routing API key phía server cho auto/motorcycle travel time.
# Browser tiles dùng domain authentication, không dùng NEXT_PUBLIC_ key.
STADIA_MAPS_API_KEY=

# Chỉ điền khi bootstrap Admin ban đầu.
# Chạy: npm run auth:bootstrap-admin --workspace web
# Sau khi bootstrap xong, có thể xóa hoặc để trống các giá trị này.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ==========================================
# AI QUESTION ANSWERING — US-21 / US-23
# ==========================================

# Local development
QA_RUNTIME_ENABLED=false

# Vercel Preview
QA_PREVIEW_RUNTIME_ENABLED=false

# Chỉ bật sau khi chấp nhận abuse controls
QA_ABUSE_PROTECTION_ACCEPTED=false

# Chỉ cho phép Neon Development
QA_RUNTIME_ALLOWED_DATABASE_HOST=
QA_RUNTIME_ALLOWED_DATABASE_NAME=

# Server-side HMAC secret
QA_NETWORK_HMAC_SECRET=

# ID nguồn được duyệt công khai metadata/citation
QA_PUBLIC_SOURCE_IDS=

# Local network identity dùng cho kiểm thử
QA_LOCAL_NETWORK_ID=

# Cleanup — mặc định tắt
QA_CLEANUP_ENABLED=false
QA_CLEANUP_ALLOWED_DATABASE_HOST=
QA_CLEANUP_ALLOWED_DATABASE_NAME=
CRON_SECRET=
