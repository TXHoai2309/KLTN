# KLTN — thông tin xác thực và cấu hình khởi động của web.
# Chép thành apps/web/.env để chạy local. Cấu hình từng môi trường Vercel riêng.
# Quản lý thiết lập tính năng và model tại /admin/settings.
# Xem docs/implementation/environment-deployment.md để chuyển thiết lập cũ vào Admin.

# URL gốc để Better Auth tạo callback và xác thực phiên khi chạy local.
BETTER_AUTH_URL=http://localhost:3010
# Secret riêng để ký dữ liệu xác thực của Better Auth.
BETTER_AUTH_SECRET=
# Chuỗi kết nối Neon PostgreSQL cho đăng nhập, dữ liệu du lịch và cấu hình Admin.
DATABASE_URL=

# Khóa OpenAI phía server cho hỏi đáp, lập lịch, phân tích nhu cầu, biên tập và embeddings.
OPENAI_API_KEY=
# Token ghi vào Vercel Blob riêng tư để lưu tài liệu nguồn phục vụ RAG.
BLOB_READ_WRITE_TOKEN=

# Tên môi trường Cloudinary lưu ảnh điểm đến.
CLOUDINARY_CLOUD_NAME=
# Định danh tài khoản để gọi API ảnh Cloudinary từ máy chủ.
CLOUDINARY_API_KEY=
# Secret ký thao tác tải lên và quản lý ảnh Cloudinary từ máy chủ.
CLOUDINARY_API_SECRET=

# Khóa Stadia phía server để tính tuyến và thời gian di chuyển khi chọn Stadia.
STADIA_MAPS_API_KEY=
# Khóa Google phía server cho tính tuyến và tìm địa điểm qua Routes và Places API.
GOOGLE_MAPS_API_KEY=
# Khóa Google Maps JavaScript công khai, giới hạn theo domain được cấp quyền.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Khóa Firecrawl phía server để trợ lý lập lịch tìm trên web và đọc nội dung trang.
FIRECRAWL_API_KEY=

# Khóa mã hóa 32 byte dạng 64 ký tự hex cho các thiết lập lưu qua Admin.
RUNTIME_CONFIG_ENCRYPTION_KEY=
# Khóa mã hóa cũ, chỉ cần trong lúc mã hóa lại dữ liệu để xoay khóa.
RUNTIME_CONFIG_ENCRYPTION_KEY_PREVIOUS=
# Khóa HMAC để ký định danh mạng dùng cho kiểm soát lạm dụng QA.
QA_NETWORK_HMAC_SECRET=
# Secret để tác vụ định kỳ xác thực khi gọi endpoint dọn dữ liệu QA.
CRON_SECRET=

# ==========================================
# TRIPSAGE-STYLE PLANNING CHAT — ADR-36
# ==========================================
# Server-only switch. Off unless exactly "true".
TRIPSAGE_CHAT_ENABLED=false

# Independent server-only tool groups for the planning chat.
TRIPSAGE_FEATURE_BUDGET=false
TRIPSAGE_FEATURE_FLIGHTS=false
TRIPSAGE_FEATURE_HOTELS=false
TRIPSAGE_FEATURE_MEMORY=false
TRIPSAGE_FEATURE_CALENDAR=false

# Server-only SerpApi keys (comma-separated, never NEXT_PUBLIC_).
SERPAPI_API_KEYS=
